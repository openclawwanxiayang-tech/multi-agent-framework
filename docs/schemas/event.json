{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "description": "Append-only event log entry (NDJSON)",
  "type": "object",
  "required": ["ts", "trace_id", "task_id", "agent", "type"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique event ID (UUID)"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "trace_id": {
      "type": "string",
      "description": "Unique trace for this execution"
    },
    "task_id": {
      "type": "string",
      "description": "Task reference"
    },
    "agent": {
      "type": "string",
      "description": "Agent identifier"
    },
    "role": {
      "type": "string",
      "description": "Agent role (pm, designer, dev, qa, etc.)"
    },
    "type": {
      "type": "string",
      "enum": [
        "artifact_write",
        "artifact_read",
        "tool_call",
        "tool_result",
        "validator",
        "validator_result",
        "stage_transition",
        "approval",
        "approval_granted",
        "approval_denied",
        "error",
        "state_recovered",
        "state_load_failed",
        "lock_acquired",
        "lock_released",
        "lock_recovered",
        "checkpoint_verified",
        "checkpoint_mismatch",
        "recovery_started",
        "recovery_blocked",
        "recovery_skipped",
        "recovery_failed"
      ],
      "description": "Event type"
    },
    "path": {
      "type": "string",
      "description": "File path (for artifact events)"
    },
    "hash": {
      "type": "string",
      "description": "SHA256 of artifact content"
    },
    "tool": {
      "type": "string",
      "description": "Tool name (for tool_call events)"
    },
    "input": {
      "type": "object",
      "description": "Tool input"
    },
    "output": {
      "type": "object",
      "description": "Tool output"
    },
    "result": {
      "type": "string",
      "enum": ["success", "failure", "skipped"],
      "description": "Event result"
    },
    "details": {
      "type": "object",
      "description": "Additional event details"
    },
    "level": {
      "type": "string",
      "enum": ["info", "warning", "error"],
      "default": "info"
    }
  }
}
