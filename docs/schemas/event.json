{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$version": "1.0.0",
  "title": "Event",
  "description": "Append-only event log entry (NDJSON) - v1.0.0",
  "type": "object",
  "required": ["$version", "ts", "trace_id", "task_id", "agent", "type"],
  "properties": {
    "$version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version for migration tracking"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "trace_id": {
      "type": "string",
      "description": "Unique trace for this execution"
    },
    "task_id": {
      "type": "string",
      "description": "Task reference"
    },
    "agent": {
      "type": "string",
      "description": "Agent identifier"
    },
    "role": {
      "type": "string",
      "description": "Agent role (pm, designer, dev, qa, etc.)"
    },
    "type": {
      "type": "string",
      "enum": ["artifact_write", "artifact_read", "tool_call", "validator", "stage_transition", "approval", "error"],
      "description": "Event type"
    },
    "path": {
      "type": "string",
      "description": "File path (for artifact events)"
    },
    "hash": {
      "type": "string",
      "description": "SHA256 of artifact content"
    },
    "tool": {
      "type": "string",
      "description": "Tool name (for tool_call events)"
    },
    "input": {
      "type": "object",
      "description": "Tool input"
    },
    "output": {
      "type": "object",
      "description": "Tool output"
    },
    "result": {
      "type": "string",
      "enum": ["success", "failure", "skipped"],
      "description": "Event result"
    },
    "details": {
      "type": "object",
      "description": "Additional event details"
    },
    "level": {
      "type": "string",
      "enum": ["info", "warning", "error"],
      "default": "info"
    }
  }
}
