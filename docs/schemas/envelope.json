{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$version": "1.0.0",
  "title": "Envelope",
  "description": "Structured handoff between agents - v1.0.0",
  "type": "object",
  "required": ["$version", "task_id", "from_role", "to_role", "stage", "outputs"],
  "properties": {
    "$version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Schema version for migration tracking"
    },
    "task_id": {
      "type": "string",
      "description": "Task reference"
    },
    "from_role": {
      "type": "string",
      "description": "Sending role"
    },
    "to_role": {
      "type": "string",
      "description": "Receiving role (or 'director' for orchestrator)"
    },
    "stage": {
      "type": "string",
      "description": "Current workflow stage"
    },
    "outputs": {
      "type": "object",
      "description": "Artifacts produced",
      "additionalProperties": {"type": "string"}
    },
    "claims": {
      "type": "object",
      "properties": {
        "scope_locked": {"type": "boolean"},
        "open_questions": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "version": {"type": "integer"}
      }
    }
  }
}
