# Overnight autonomous execution policy (set 2026-02-24)
MODE=full_autonomous
PUSH_POLICY=checks_pass
CHECKPOINT_MINUTES=30
ON_CHECK_FAIL=commit_wip_no_push
BRANCH=fix/mvp-surface-area
REMOTE=origin

# Optional: command to run one autonomous work cycle (can call scripts/subagent orchestration)
# Leave empty to skip task execution in checkpoint script.
WORK_CYCLE_CMD=/home/lenovo/.openclaw/workspace/scripts/overnight_work_cycle.sh
